###############################################################################
# OpenFMR — Global Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# This file is the SINGLE SOURCE OF TRUTH for credentials and configuration
# shared across every OpenFMR Docker Compose stack.
#
# Each sub-module's docker-compose.yml references this file via:
#   docker-compose --env-file ../.env.global up -d
#
# ⚠️  CHANGE EVERY DEFAULT PASSWORD BEFORE ANY PRODUCTION DEPLOYMENT.
###############################################################################

# ── Organisation / Project Tag ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=openfmr

# ── Shared Docker Network ───────────────────────────────────────────────────
# All services attach to this pre-created external network so they can
# communicate across Compose files.
OPENFMR_NETWORK=openfmr_global_net

# ── PostgreSQL Master Credentials ────────────────────────────────────────────
# Used by openfmr-core and every module that runs its own Postgres container.
POSTGRES_USER=openfmr_admin
POSTGRES_PASSWORD=Change_Me_Postgres_2024!
POSTGRES_DB=openfmr

# ── HAPI FHIR Server ────────────────────────────────────────────────────────
HAPI_FHIR_VERSION=latest
HAPI_FHIR_PORT=8080

# ── OpenHIM (Interoperability Layer) ─────────────────────────────────────────
OPENHIM_CORE_IMAGE=jembi/openhim-core:latest
OPENHIM_CONSOLE_IMAGE=jembi/openhim-console:latest
OPENHIM_MONGO_IMAGE=mongo:4.4

# Root-channel API user configured on first boot
OPENHIM_ROOT_USER=root@openhim.org
OPENHIM_ROOT_PASSWORD=Change_Me_OpenHIM_2024!

# Ports exposed on the Docker host
OPENHIM_API_PORT=8085
OPENHIM_HTTPS_PORT=5000
OPENHIM_HTTP_PORT=5001
OPENHIM_CONSOLE_PORT=9000

# ── Keycloak (Identity & Access Management) ─────────────────────────────────
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:latest
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Change_Me_Keycloak_2024!
KEYCLOAK_PORT=8443
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_ADDR=keycloak-db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=Change_Me_KC_DB_2024!
KEYCLOAK_DB_NAME=keycloak

# ── Module-Specific Database Names ──────────────────────────────────────────
# Each registry module creates its own Postgres database.  The credentials
# above (POSTGRES_USER / POSTGRES_PASSWORD) are reused; only the DB name
# differs.
CR_DB_NAME=openfmr_cr
HFR_DB_NAME=openfmr_hfr
TS_DB_NAME=openfmr_ts
SHR_DB_NAME=openfmr_shr
LMIS_DB_NAME=openfmr_lmis

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
